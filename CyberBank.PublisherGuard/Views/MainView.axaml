<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CyberBank.PublisherGuard.ViewModels"
             mc:Ignorable="d"
             x:Class="CyberBank.PublisherGuard.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable" />
            <Setter Property="Foreground" Value="#E6E9EB" />
        </Style>
        <Style Selector="TextBlock.kicker">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#91AAB4" />
            <Setter Property="LetterSpacing" Value="1.15" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#849098" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="Segoe UI Variable" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#172126" />
            <Setter Property="Foreground" Value="#DAE3E7" />
            <Setter Property="BorderBrush" Value="#33434A" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.primary-action">
            <Setter Property="Background" Value="#C8843E" />
            <Setter Property="Foreground" Value="#15100B" />
            <Setter Property="BorderBrush" Value="#E6A85B" />
        </Style>
        <Style Selector="Button.ghost-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#334047" />
            <Setter Property="Foreground" Value="#AFC0C7" />
        </Style>
        <Style Selector="Border.stage">
            <Setter Property="Background" Value="#11191D" />
            <Setter Property="BorderBrush" Value="#2D3A40" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
    </UserControl.Styles>

    <Grid Background="#0A0D0F" RowDefinitions="70,*,50,24">
        <Border Grid.Row="0" Background="#101518" BorderBrush="#28353A" BorderThickness="0,0,0,1">
            <Grid Margin="14,0" ColumnDefinitions="252,*">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="11">
                    <Border Width="46" Height="46" CornerRadius="9" Background="#141B20" BorderBrush="#647A86" BorderThickness="1">
                        <Image Source="/Assets/Brand/publisher_guard_globe_l.png" Stretch="Uniform" Margin="1" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="CYBERBANK" Classes="kicker" Foreground="#9AB4BE" />
                        <TextBlock Text="Publisher Guard" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="LOCAL PACKAGE REVIEW &amp; DELIVERY" FontSize="9" Foreground="#71828A" LetterSpacing="0.75" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10" Margin="26,0">
                    <Border Background="#121A1E" BorderBrush="#314149" BorderThickness="1" CornerRadius="3" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="PACKAGE" Classes="kicker" Foreground="#809DA8" />
                            <TextBlock Text="{Binding SourceRootDisplay}" FontSize="12" Foreground="#C4D0D5" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                        </StackPanel>
                    </Border>
                    <Border Background="#102126" BorderBrush="#285163" BorderThickness="1" CornerRadius="3" Padding="10,6">
                        <TextBlock Text="{Binding ActiveStage}" Classes="kicker" Foreground="#A8D9E8" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12,10,12,8" ColumnDefinitions="230,12,*,12,274">
            <Border Grid.Column="0" Background="#0E1316" BorderBrush="#28353B" BorderThickness="1" CornerRadius="6">
                <Grid RowDefinitions="74,*,62">
                    <StackPanel Margin="18,16,18,0" Spacing="4">
                        <TextBlock Text="PACKAGE LIBRARY" Classes="kicker" />
                        <TextBlock Text="Your local files and delivery choices" FontSize="12" Classes="muted" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Margin="14,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14">
                            <Border Background="#121A1D" BorderBrush="#2B3A40" BorderThickness="1" CornerRadius="4" Padding="12">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="CURRENT PACKAGE" Classes="kicker" Foreground="#819DA7" />
                                    <TextBlock Text="{Binding SourceRootDisplay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="Files stay on this device. Nothing is executed or uploaded." FontSize="11" Classes="muted" TextWrapping="Wrap" LineHeight="16" />
                                    <Border Height="1" Background="#26383E" Margin="0,5,0,2" />
                                    <TextBlock Text="REVIEW PRESET" Classes="kicker" Foreground="#819DA7" />
                                    <TextBlock Text="{Binding PresetName}" FontSize="11" FontWeight="SemiBold" Foreground="#B6D7E2" />
                                    <TextBlock Text="{Binding PresetDescription}" FontSize="10" Classes="muted" TextWrapping="Wrap" />
                                    <Border Height="1" Background="#26383E" Margin="0,5,0,2" />
                                    <TextBlock Text="LAST CHECK" Classes="kicker" Foreground="#819DA7" />
                                    <TextBlock Text="{Binding ChangeSummary}" FontSize="10" Foreground="#A8C5CF" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="7">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="FILES" Classes="kicker" />
                                    <TextBlock Grid.Column="1" Text="{Binding QuickCheckSummary}" FontSize="9" Foreground="#8FAFBA" TextTrimming="CharacterEllipsis" MaxWidth="168" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding PackageEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PackageEntryRow">
                                            <Border Background="#0B1012" BorderBrush="#233137" BorderThickness="1" CornerRadius="3" Padding="9" Margin="0,0,0,4">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding RelativePath}" FontFamily="Cascadia Mono" FontSize="11" Foreground="#D2DCE0" TextTrimming="CharacterEllipsis" />
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Type}" FontSize="9" Classes="muted" />
                                                        <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="9" Foreground="#9DCBD9" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#0A0F11" BorderBrush="#29363B" BorderThickness="0,1,0,0" Padding="18,0">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="LOCAL ROOTS ONLY" Classes="kicker" Foreground="#91B4C0" />
                            <TextBlock Text="Separate source and delivery folders" FontSize="10" Classes="muted" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#0A0E10" BorderBrush="#28383E" BorderThickness="1" CornerRadius="6">
            <Grid RowDefinitions="148,*,60">
                <StackPanel Margin="18,16,18,10" Spacing="10">
                    <StackPanel Spacing="5">
                        <TextBlock Text="REVIEW CANVAS" Classes="kicker" />
                        <TextBlock Text="{Binding ReadinessHeadline}" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Text="Review the package once, make only the decisions that matter, then create a clean local delivery." FontSize="12" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Classes="stage"><TextBlock Text="1  CHOOSE" FontSize="10" Foreground="#9AA9AF" /></Border>
                        <Border Classes="stage"><TextBlock Text="2  CHECK" FontSize="10" Foreground="#9AA9AF" /></Border>
                        <Border Classes="stage"><TextBlock Text="3  RESOLVE" FontSize="10" Foreground="#9AA9AF" /></Border>
                        <Border Classes="stage"><TextBlock Text="4  DELIVER" FontSize="10" Foreground="#9AA9AF" /></Border>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="18,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <Border Background="#111B1F" BorderBrush="#2F4B54" BorderThickness="1" CornerRadius="5" Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="NEXT ACTION" Classes="kicker" Foreground="#A5D5E5" />
                                    <TextBlock Text="{Binding ReadinessHeadline}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="Publisher Guard checks only the folder you choose and keeps the evidence beside your delivery." FontSize="11" Classes="muted" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Classes="primary-action" Content="{Binding PrimaryActionLabel}" Click="RunPrimaryAction" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="*,Auto" Margin="2,0">
                            <StackPanel Spacing="3">
                                <TextBlock Text="ITEMS TO REVIEW" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="These are the only items that can stop the local delivery." FontSize="11" Classes="muted" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="SELECT AN ITEM FOR DETAILS" Classes="kicker" VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Issues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:IssueRow">
                                    <Border Background="#101619" BorderBrush="#2B393F" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="84,*,Auto" RowDefinitions="Auto,Auto">
                                            <Border Background="#2B2117" CornerRadius="3" Padding="7,4" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="SemiBold" Foreground="#E5B56F" HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0" Spacing="3">
                                                <TextBlock Text="{Binding RelativePath}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Summary}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                <Button Classes="ghost-action" Content="Details" Tag="{Binding}" Click="ViewIssueDetails" Padding="9,5" FontSize="10" />
                                                <Button Content="Keep out" Tag="{Binding}" Click="ExcludeIssue" Padding="9,5" FontSize="10" />
                                                <Button Classes="ghost-action" Content="Always ignore" Tag="{Binding}" Click="RememberIssue" Padding="9,5" FontSize="10" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,8,0,0" Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Rule:" FontSize="10" Classes="muted" />
                                                <TextBlock Text="{Binding RuleId}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#91C7DC" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#0D1315" BorderBrush="#29383E" BorderThickness="0,1,0,0" Padding="18,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="9">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#6EAFC4" />
                            <TextBlock Text="{Binding FriendlyState}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="Local review only" FontSize="11" Classes="muted" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="No upload · No source execution" VerticalAlignment="Center" FontSize="10" Foreground="#81929A" />
                    </Grid>
                </Border>
            </Grid>
            </Border>

            <Border Grid.Column="4" Background="#0F1518" BorderBrush="#2A393F" BorderThickness="1" CornerRadius="6">
                <Grid RowDefinitions="64,*,126">
                    <StackPanel Margin="18,12,18,0" Spacing="4">
                        <TextBlock Text="DELIVERY DETAILS" Classes="kicker" />
                        <TextBlock Text="What the selected item means" FontSize="12" Classes="muted" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Margin="16,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14">
                            <Border Background="#121B1F" BorderBrush="#2C4048" BorderThickness="1" CornerRadius="4" Padding="14">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="{Binding DetailsHeadline}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DetailsExplanation}" FontSize="11" Classes="muted" TextWrapping="Wrap" LineHeight="16" />
                                    <TextBlock Text="{Binding DetailsActionLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#E0B46F" />
                                </StackPanel>
                            </Border>

                            <Border Background="#0D1315" BorderBrush="#293940" BorderThickness="1" CornerRadius="4" Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="LOCAL DELIVERY PLAN" Classes="kicker" Foreground="#9DCBDD" />
                                    <TextBlock Text="The created folder contains only included files, a manifest, SHA-256 evidence, and a local activity record." FontSize="11" Classes="muted" TextWrapping="Wrap" LineHeight="16" />
                                    <StackPanel Spacing="5" Margin="0,4,0,0">
                                        <TextBlock Text="• Included package files" FontSize="11" Foreground="#C4D0D5" />
                                        <TextBlock Text="• Readable delivery report" FontSize="11" Foreground="#C4D0D5" />
                                        <TextBlock Text="• Delivery manifest" FontSize="11" Foreground="#C4D0D5" />
                                        <TextBlock Text="• SHA-256 evidence and activity record" FontSize="11" Foreground="#C4D0D5" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Expander Header="Technical details" Foreground="#9CB6C0">
                                <StackPanel Margin="0,10,0,0" Spacing="5">
                                    <TextBlock Text="{Binding LocalEngineState}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#93C7D8" />
                                    <TextBlock Text="Rule identifiers and hashes remain available here when you need them." FontSize="10" Classes="muted" TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#0B1113" BorderBrush="#293A40" BorderThickness="0,1,0,0" Padding="14,10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="DELIVERY GATE" Classes="kicker" Foreground="#A7D0DF" />
                            <TextBlock Text="{Binding FriendlyState}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Delivery is enabled after every open item is resolved." FontSize="10" Classes="muted" TextWrapping="Wrap" />
                            <TextBlock Text="Continue from the Next Action panel." FontSize="10" Foreground="#9CC8D8" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="12,0,12,0" Background="#0D1315" BorderBrush="#2A393F" BorderThickness="1" CornerRadius="5" Padding="14,0">
            <Grid ColumnDefinitions="236,*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="DELIVERY ACTIVITY" Classes="kicker" />
                    <TextBlock Text="Local activity appears here while a delivery is running." FontSize="10" Classes="muted" />
                </StackPanel>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Margin="18,0">
                    <ItemsControl ItemsSource="{Binding BuildQueue}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:QueueRow">
                                <Border Background="#101A1E" BorderBrush="#2C414A" BorderThickness="1" CornerRadius="3" Padding="10,7" Margin="0,20,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#98C8D9" />
                                        <TextBlock Text="{Binding Operation}" FontSize="10" Foreground="#D2DDE1" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Column="2" Classes="ghost-action" Content="Cancel build" Click="CancelCurrentBuild" IsVisible="{Binding IsBuildActive}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#090D0E" Padding="18,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="13" VerticalAlignment="Center">
                    <TextBlock Text="LOCAL ENGINE" Classes="kicker" Foreground="#91B8C6" />
                    <TextBlock Text="•" FontSize="10" Foreground="#4B5C64" />
                    <TextBlock Text="NO NETWORK TRANSFER" FontSize="10" Foreground="#75868E" />
                    <TextBlock Text="•" FontSize="10" Foreground="#4B5C64" />
                    <TextBlock Text="NO SOURCE EXECUTION" FontSize="10" Foreground="#75868E" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="PUBLISHER GUARD · LOCAL ALPHA" VerticalAlignment="Center" FontSize="10" Foreground="#687982" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
